---
/* En-tête de section : « 01  Titre ———— » (styles : src/styles/section.css). */
interface Props {
  num: string;
  title: string;
}

const { num, title } = Astro.props;
---
<div class="sec-head rv">
  <span class="sec-num">{num}</span>
  <h2 class="sec-title serif">{title}</h2>
  <span class="rule"></span>
</div>
