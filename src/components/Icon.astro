---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
}

const icon: { stroke: string } | { fill: string } = icons[Astro.props.name];
---
{'stroke' in icon
  ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icon.stroke} />
  : <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icon.fill} />}
